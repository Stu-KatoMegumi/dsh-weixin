{
  "name": "@deepseek-ai/dsh-weixin",
  "version": "1.1.0",
  "type": "module",
  "description": "微信 iLink 通道与 DSH 的流式智能代理插件",
  "main": "./src/plugin/index.mjs",
  "exports": {
    ".": "./src/plugin/index.mjs",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "version.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/standalone/main.mjs",
    "install:dsh": "node install.mjs",
    "uninstall:dsh": "node install.mjs --uninstall",
    "test": "node --test test/core.test.mjs test/transport.test.mjs",
    "check": "node scripts/check.mjs"
  }
}
